; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Boss Killers"
config/description="Two wizards, fire and ice, fight through the underworld together."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://autoload/game_state.gd"
PlayerInput="*res://autoload/player_input.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="enemies"
3d_physics/layer_5="shields"
3d_physics/layer_6="element_targets"

[physics]

jolt_physics_3d/simulation/areas_detect_static_bodies=true

[rendering]

environment/defaults/default_clear_color=Color(0, 0, 0, 1)
